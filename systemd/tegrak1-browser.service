[Unit]
Description=Tegra K1 kiosk browser (Cog / WPE WebKit)
After=graphical.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Environment=LD_LIBRARY_PATH=/opt/tegrak1-browser/lib:/usr/lib/arm-linux-gnueabihf/tegra
Environment=COG_PLATFORM_NAME=fdo
ExecStart=/opt/tegrak1-browser/run-cog.sh https://example.com
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
